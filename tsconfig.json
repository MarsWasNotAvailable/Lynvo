{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "bundler",
    "types": ["node"],
    "outDir": "dist",
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react",
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", ".vscode-test", "dist", "src/test"]
}
