{
  "name": "lynvo",
  "displayName": "Lynvo - Project Board by Sergio",
  "description": "Professional Kanban board integrated with GitHub and your code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lynvo.testAuth",
        "title": "Lynvo: Test GitHub Identity"
      },
      {
        "command": "lynvo.openBoard",
        "title": "Lynvo: Open Project Board"
      },
      {
        "command": "lynvo.openInsights",
        "title": "Lynvo: Open Insights"
      },
      {
        "command": "lynvo.openLabels",
        "title": "Lynvo: Manage Labels"
      },
      {
        "command": "lynvo.syncBoard",
        "title": "Lynvo: Sync Board with GitHub"
      },
      {
        "command": "lynvo.createTaskQuick",
        "title": "Lynvo: Create Quick Task"
      },
      {
        "command": "lynvo.createTaskFromCode",
        "title": "Lynvo: Crear Tarea desde Selección"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lynvo.createTaskFromCode",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lynvo-explorer",
          "title": "Lynvo",
          "icon": "$(project)"
        }
      ]
    },
    "views": {
      "lynvo-explorer": [
        {
          "id": "lynvo.sidebarMenu",
          "name": "Acciones del Proyecto",
          "icon": "$(list-flat)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
